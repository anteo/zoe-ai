<% content_for :title, t("development.label_ui_preview") %>

<div class="app-shell app-shell-fixed relative grid min-h-0 grid-rows-[auto_1fr_auto] gap-4 bg-base-200"
     data-controller="history-drawer" data-action="keydown@window->history-drawer#handleKeydown">
  <header class="relative z-10 flex items-center">
    <h1 class="grow font-semibold"><%= t("development.label_ui_preview") %></h1>
    <%= component :chats__history_drawer, show_trigger: false %>
    <%= render "shared/theme_toggle" %>
    <%= turbo_frame_tag :profile_menu do %>
      <%= component :ui__profile_menu, current_user: %>
    <% end %>
  </header>

  <% path_for_conversation = ->(run) { development_agent_activity_dialog_path(run.agent_conversation_id) } %>
  <%= render Chats::ChatComponent.new(chat: @chat, messages: @messages, agent_runs: @runs, path_for_conversation:) %>

  <div inert>
    <%= component :chats__chat_input, current_character:, chat: @chat %>
  </div>
</div>
