<%= turbo_frame_tag "agent-conversation-detail", class: "block min-w-0" do %>
  <section class="mx-auto w-full max-w-4xl space-y-4 p-4">
    <% unless turbo_frame_request? %>
      <header class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-lg font-bold wrap-anywhere"><%= @agent_conversation.agent_name %></h1>
        <%= link_to t(:label_back), local_assigns.fetch(:back_path) { @history_chat.closed? ? root_path : chat_path(@history_chat) },
                    class: "btn btn-ghost btn-sm", data: { turbo_frame: "_top" } %>
      </header>
    <% end %>

    <%= render "chats/agent_conversation_runs", runs: @conversation_runs, sender: @history_chat.partner %>
  </section>
<% end %>
