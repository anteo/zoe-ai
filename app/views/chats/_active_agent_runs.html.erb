<div class="pointer-events-none absolute start-7 end-3 bottom-full z-1 mb-1.5 inert:translate-y-1 inert:opacity-0
            transition duration-200 ease-out motion-reduce:transition-none"
     id="active-agent-runs-<%= chat.id %>" data-turbo-permanent data-active-agent-runs-target="strip" inert>
  <a class="btn btn-sm pointer-events-auto max-w-full" data-active-agent-runs-target="single" hidden>
    <span class="loading loading-spinner loading-xs shrink-0 text-info motion-reduce:animate-none" aria-hidden="true"></span>
    <span class="truncate" data-active-agent-runs-target="name"></span>
    <span class="shrink-0 text-base-content/70" aria-hidden="true">·</span>
    <span class="truncate font-normal text-base-content/70" data-active-agent-runs-target="status"></span>
    <span class="icon-[lucide--arrow-up-right] size-3.5 shrink-0" aria-hidden="true"></span>
  </a>

  <details class="dropdown dropdown-top w-full" data-active-agent-runs-target="menu"
           data-action="keydown.esc->active-agent-runs#closeMenu" hidden>
    <summary class="btn btn-sm pointer-events-auto max-w-full">
      <span class="loading loading-spinner loading-xs shrink-0 text-info motion-reduce:animate-none" aria-hidden="true"></span>
      <span class="truncate"><%= t("agent_runs.label_active") %></span>
      <span class="shrink-0 text-base-content/70" aria-hidden="true">·</span>
      <span class="shrink-0 tabular-nums" data-active-agent-runs-target="count"></span>
      <span class="icon-[lucide--chevron-up] size-3.5 shrink-0" aria-hidden="true"></span>
    </summary>
    <ul class="menu menu-sm dropdown-content pointer-events-auto start-0 mb-2 max-h-48 w-72 max-w-full flex-nowrap overflow-x-hidden overflow-y-auto rounded-box border border-base-300 bg-base-200 shadow-sm"
        data-active-agent-runs-target="items"></ul>
  </details>

  <template data-active-agent-runs-target="itemTemplate">
    <li class="min-w-0">
      <a class="block w-full min-w-0">
        <span class="block truncate font-medium" data-agent-run-item-name></span>
        <span class="block truncate text-xs text-base-content/70" data-agent-run-item-task></span>
      </a>
    </li>
  </template>
</div>
