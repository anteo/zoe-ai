<div class="space-y-6">
  <fieldset class="border border-base-300 rounded-lg p-4">
    <legend class="px-1 font-semibold text-sm"><%= t(:label_settings_ai_voice_generation) %></legend>
    <div class="space-y-4">
      <%= f.input :voice %>
      <%= f.input :allowed_styles,
                  as: :text,
                  input_html: { rows: 3 } %>
    </div>
  </fieldset>

  <fieldset class="border border-base-300 rounded-lg p-4">
    <legend class="px-1 font-semibold text-sm"><%= t(:label_settings_ai_voice_recognition) %></legend>
    <div class="space-y-4">
      <%= f.input :silence_delay_ms,
                  input_html: { min: 100, step: 50 } %>
      <%= f.input :silence_rms_threshold,
                  input_html: { min: 0.001, step: 0.001 } %>
    </div>
  </fieldset>
</div>
