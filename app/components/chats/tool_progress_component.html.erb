<span class="mt-1 block chat-message-enter">
  <span class="relative flex items-center gap-1.5 text-gray-500 <%= typography_class %>">
    <% if icon.present? %>
      <span class="<%= icon %> absolute end-full me-1" aria-hidden="true"></span>
    <% end %>
    <span class="min-w-0 wrap-anywhere" role="status"><%= text %></span>
    <%= content %>
  </span>
</span>
