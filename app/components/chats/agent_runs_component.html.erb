<% cards = capture do %>
  <% if runs.any? %>
    <div class="my-2 flex min-w-0 flex-col gap-2 px-3">
      <% runs.each do |run| %>
        <details id="<%= card_id(run) %>"
                 class="group/run min-w-0"
                 data-action="turbo:before-morph-attribute->chat#preserveRunDetails">
          <% path = conversation_path(run) %>
          <% run_phase = phase(run) %>
          <% latest_activity = run_phase == "running" && helpers.agent_run_latest_activity(run) %>
          <summary class="flex w-fit max-w-full cursor-pointer list-none flex-col items-start gap-1 py-1 text-sm [&::-webkit-details-marker]:hidden"
                   <% if live? && run.running? %>
                     data-active-agent-runs-target="card"
                     data-agent-run-name="<%= run.agent_name %>"
                     data-agent-run-status="<%= t("agent_runs.status.#{run_phase}") %>"
                     data-agent-run-task="<%= run.task.strip.lines.first.to_s.strip.truncate(160) %>"
                   <% end %>>
            <span class="flex min-w-0 max-w-full items-center gap-2">
              <span class="icon-[lucide--workflow] size-4 shrink-0" aria-hidden="true"></span>
              <span class="min-w-0 font-medium wrap-anywhere"><%= run.agent_name %></span>
              <span class="sr-only"><%= t("agent_runs.label_activity") %></span>
              <% if path %>
                <%= link_to path, class: "btn btn-ghost btn-square btn-sm shrink-0",
                            title: t("agent_conversations.label_open"), aria: { label: t("agent_conversations.label_open"), controls: "agent-conversation-detail" },
                            data: { action: "click->history-drawer#openAgentDetail", turbo_frame: "agent-conversation-detail", turbo_prefetch: false, agent_conversation_id: run.agent_conversation_id } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                       fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                       aria-hidden="true" focusable="false">
                    <path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    <path d="M7 8h10M7 12h7"/>
                  </svg>
                <% end %>
              <% end %>
              <span class="icon-[lucide--chevron-down] size-4 shrink-0 group-open/run:rotate-180" aria-hidden="true"></span>
            </span>
            <span class="badge badge-soft badge-sm ms-6 h-auto min-h-5 max-w-[calc(100%_-_1.5rem)] wrap-anywhere <%= status_class(run) %>" role="status">
              <% if run.running? %>
                <span class="loading loading-spinner loading-xs shrink-0" aria-hidden="true"></span>
              <% end %>
              <% if latest_activity %>
                <span class="group-open/run:hidden"><%= latest_activity %></span>
                <span class="hidden group-open/run:inline"><%= t("agent_runs.status.#{run_phase}") %></span>
              <% else %>
                <%= t("agent_runs.status.#{run_phase}") %>
              <% end %>
            </span>
          </summary>
          <div class="pt-1 text-sm">
            <p class="whitespace-pre-wrap wrap-anywhere"><%= run.task %></p>
            <%= render "chats/agent_run_progress", run:, id_prefix: card_id(run), show_arguments: path.present? %>
          </div>
        </details>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if live? %>
  <%= helpers.turbo_frame_tag(frame_id, **frame_options) { cards } %>
<% else %>
  <%= cards %>
<% end %>
