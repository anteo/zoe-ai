<div class="app-scroll-region min-h-0 overflow-y-auto p-4 rounded-field shadow-sm bg-base-100"
     id="<%= dom_id %>"
     data-controller="<%= [read_only? ? "history-chat" : "chat", "lightbox"].join(" ") %>"
     <% unless read_only? %>
       data-action="scroll->chat#trackScroll:passive agent-run:inserted->chat#placeAgentRun turbo:frame-render->chat#placeAgentRun"
     <% end %>>
  <% if new? %>
    <% if pending_messages.empty? %>
      <div id="<%= draft_empty_state_id %>" class="flex flex-col items-center justify-center h-full min-h-[300px]">
        <div class="animate-[float_6s_ease-in-out_infinite]">
          <%= avatar_for_character(current_partner, css_class: "w-30 h-30") %>
        </div>
        <p class="mt-6 text-lg text-center text-base-content">
          <%= t(:text_greeting_html, name: current_partner.name).html_safe %>
        </p>
      </div>
    <% end %>

    <div id="<%= draft_messages_id %>">
      <% pending_messages.each do |message| %>
        <%= helpers.component :chats__message, message:, current_character:, read_only: read_only? %>
      <% end %>
    </div>
  <% else %>
    <div data-chat-target="timeline">
      <% timeline.each do |entry| %>
        <% if entry.is_a?(AgentRun) %>
          <%= render Chats::AgentRunComponent.new(chat:, run: entry, read_only: read_only?, path_for_conversation:) %>
        <% else %>
          <%= helpers.component :chats__message, message: entry, current_character:, read_only: read_only? %>
        <% end %>
      <% end %>

      <% unless read_only? %>
        <div id="<%= self.class.placeholder_id(chat.id) %>" data-chat-target="placeholder">
          <% if show_typing_indicator? %>
            <%= helpers.component :chats__message_placeholder, chat:, current_character: %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% unless read_only? %><div id="tool-progress-slot-<%= chat.id %>"></div><% end %>

    <div <% unless read_only? %>id="<%= self.class.active_runs_id(chat.id) %>" data-chat-target="activeRuns"<% end %>>
      <% active_runs.each do |run| %>
        <%= render Chats::AgentRunComponent.new(chat:, run:, read_only: read_only?, path_for_conversation:) %>
      <% end %>
    </div>
  <% end %>
</div>
