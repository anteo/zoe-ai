<div class="chat-header px-3 flex items-center gap-1 mb-1">
  <% if component.editable_message? %>
    <span class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-0.5 mr-1">
      <button class="btn btn-ghost btn-xs p-0.5 min-h-0 h-auto"
              title="<%= t(:label_edit) %>"
              data-action="click->message#startEdit">
        <span class="icon-[lucide--pencil] w-3 h-3"></span>
      </button>
      <%= button_to resend_message_path(component.message), method: :post,
                    class: "btn btn-ghost btn-xs p-0.5 min-h-0 h-auto",
                    title: t(:label_resend),
                    data: { turbo_stream: true } do %>
        <span class="icon-[lucide--rotate-ccw] w-3 h-3"></span>
      <% end %>
      <%= button_to message_path(component.message), method: :delete,
                    class: "btn btn-ghost btn-xs p-0.5 min-h-0 h-auto text-error",
                    title: t(:label_delete),
                    data: { turbo_confirm: t(:confirm_delete_message), turbo_stream: true } do %>
        <span class="icon-[lucide--trash-2] w-3 h-3"></span>
      <% end %>
    </span>
  <% end %>
  <span class="font-medium"><%= component.sender.name %></span>
  <time class="text-xs opacity-50 ml-2"><%= component.message.created_at.strftime("%H:%M") %></time>
  <% if component.postponed_message? %>
    <span class="text-warning opacity-70 ml-1 inline-flex items-center" title="<%= t(:text_proactive_message_hint) %>">
      <span class="icon-[lucide--bell-ring] w-3 h-3"></span>
    </span>
  <% end %>
  <% unless component.message.memorize %>
    <span class="icon-[lucide--bookmark-off] w-3 h-3 opacity-40 ml-1" title="<%= t(:label_memory_mode_off) %>"></span>
  <% end %>
  <% if component.deletable_message? && !component.is_current_character? %>
    <span class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-0.5 ml-1">
      <%= button_to message_path(component.message), method: :delete,
                    class: "btn btn-ghost btn-xs p-0.5 min-h-0 h-auto text-error",
                    title: t(:label_delete),
                    data: { turbo_confirm: t(:confirm_delete_message), turbo_stream: true } do %>
        <span class="icon-[lucide--trash-2] w-3 h-3"></span>
      <% end %>
    </span>
  <% end %>
</div>
